# Database (defaults to local SQLite). Example for PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/voltguard
DATABASE_URL=sqlite:///./voltguard.db

# Comma-separated origins allowed to call the API from a browser
VOLTGUARD_CORS_ORIGINS=http://localhost:8501

# Set to 1 to expose POST /vehicles/_seed_mock_fleet (wipes and reseeds vehicles). Never in prod.
VOLTGUARD_ENABLE_DEMO_ENDPOINTS=0

# Optional path to an alternative thresholds file
# VOLTGUARD_CONFIG=config/thresholds.yaml
